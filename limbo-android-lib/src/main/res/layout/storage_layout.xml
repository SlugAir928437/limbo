<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/storagesectionl"
    style="@style/Widget.Limbo.SectionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    tools:showIn="@layout/limbo_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Section Header -->
        <LinearLayout
            android:id="@+id/storageheaderl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_md">

            <ImageView
                android:layout_width="@dimen/section_header_icon_size"
                android:layout_height="@dimen/section_header_icon_size"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:src="@drawable/harddisk" />

            <TextView
                android:id="@+id/storagesectionStr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_disks"
                android:textColor="@color/colorSectionHeaderText"
                android:textSize="@dimen/section_header_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/storagesectionsummaryStr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="3"
                android:minLines="2"
                android:text=""
                android:textColor="@color/colorSummaryText"
                android:textSize="@dimen/section_summary_text_size" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:background="@color/colorDivider" />

        <!-- Section Details -->
        <LinearLayout
            android:id="@+id/storagesectionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal">

            <!-- Hard Disk A -->
            <LinearLayout
                android:id="@+id/hdaimgl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_item_height"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/hdaoptions"
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:src="@drawable/harddisk" />

                <TextView
                    android:id="@+id/hdaimgstr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/label_hard_disk_a"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />

                <Spinner
                    android:id="@+id/hdaimgval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Hard Disk B -->
            <LinearLayout
                android:id="@+id/hdbimgl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_item_height"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/hdboptions"
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:src="@drawable/harddisk" />

                <TextView
                    android:id="@+id/hdbimgstr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/label_hard_disk_b"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />

                <Spinner
                    android:id="@+id/hdbimgval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Hard Disk C -->
            <LinearLayout
                android:id="@+id/hdcimgl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_item_height"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/hdcoptions"
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:src="@drawable/harddisk" />

                <TextView
                    android:id="@+id/hdcimgstr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/label_hard_disk_c"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />

                <Spinner
                    android:id="@+id/hdcimgval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Hard Disk D -->
            <LinearLayout
                android:id="@+id/hddimgl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_item_height"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/hddoptions"
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:src="@drawable/harddisk" />

                <TextView
                    android:id="@+id/hddimgstr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/label_hard_disk_d"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />

                <Spinner
                    android:id="@+id/hddimgval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Shared Folder -->
            <LinearLayout
                android:id="@+id/sharedfolderl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_item_height"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:src="@drawable/folder" />

                <TextView
                    android:id="@+id/sharedfolderstr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/label_shared_folder"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />

                <Spinner
                    android:id="@+id/sharedfolderval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:singleLine="true" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
