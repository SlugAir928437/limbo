+ * Limbo: zink(kopper) 的 eglInitialize()。完全不碰 gralloc / DRM：
+ *   - u_gralloc_create() 会去找 vendor gralloc HAL（/vendor/lib64/hw/gralloc*），
+ *     App 的 linker 命名空间加载不到；
+ *   - droid_open_device() 需要 /dev/dri/renderD*，Mali 这类走 kbase 的内核没有。
+ * 两者任一失败，eglInitialize() 就返回失败。zink 其实只需要一块 Vulkan 设备：
+ * 屏幕表面在 eglCreateWindowSurface() 时才通过 VK_KHR_android_surface 绑定到
+ * ANativeWindow，所以这里走 kopper 的 screen 初始化即可。
+ */
+static EGLBoolean
+dri2_initialize_android_kopper(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   const char *err;
+
+   dri2_dpy->loader_extensions = droid_kopper_loader_extensions;
+
+   /* 没有 DRM fd，驱动名只能自己给：dri2_detect_swrast_kopper() 靠它判断走
+    * kopper，dri2_display_destroy() 也会 free 它。 */
+   dri2_dpy->driver_name = strdup("zink");
+   if (!dri2_dpy->driver_name) {
+      err = "DRI2: failed to allocate driver name";
+      goto cleanup;
+   }
+   dri2_dpy->fd_render_gpu = -1;
+   dri2_dpy->fd_display_gpu = -1;
+
+   dri2_detect_swrast_kopper(disp);
+   assert(dri2_dpy->kopper);
+
+   if (!dri2_create_screen(disp)) {
+      err = "DRI2: failed to create kopper screen";
+      goto cleanup;
+   }
+
+   /* zink 没有 DRM 节点：software=true 让 dri2_setup_device() 用 fd=-1 的
+    * EGLDevice（和 x11 的 kopper 路径一样）。 */
+   if (!dri2_setup_device(disp, true)) {
+      err = "DRI2: failed to setup EGLDevice";
+      goto cleanup;
+   }
+
+   dri2_setup_screen(disp);
+   dri2_setup_swap_interval(disp, 1);
+
+   disp->Extensions.KHR_image = EGL_TRUE;
+
+   droid_add_configs_for_visuals(disp, true);
+
+   /* Fill vtbl last to prevent accidentally calling virtual function during
+    * initialization.
+    */
+   dri2_dpy->vtbl = &droid_kopper_display_vtbl;
+
+   return EGL_TRUE;
+
+cleanup:
+   return _eglError(EGL_NOT_INITIALIZED, err);
