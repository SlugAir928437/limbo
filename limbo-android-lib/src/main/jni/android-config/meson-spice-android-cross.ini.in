[binaries]
c = '@CC@'
cpp = '@CXX@'
ar = '@AR@'
strip = '@STRIP@'
pkgconfig = '@PKG_CONFIG@'
pkg-config = '@PKG_CONFIG@'

[host_machine]
system = 'android'
cpu_family = '@MESON_CPU_FAMILY@'
cpu = '@MESON_CPU@'
endian = 'little'

[properties]
needs_exe_wrapper = true

[built-in options]
prefix = '@SPICE_INSTALL_DIR@'
libdir = 'lib'
buildtype = 'release'
default_library = 'static'
c_args = ['-target', '@TARGET_TRIPLE@', '--sysroot=@SYSROOT@', '-D__ANDROID__', '-DANDROID', '-D__linux__', '-Wno-error', '-include', '@LIMBO_JNI_ROOT@/compat/limbo_compat_spice.h']
cpp_args = ['-target', '@TARGET_TRIPLE@', '--sysroot=@SYSROOT@', '-D__ANDROID__', '-DANDROID', '-D__linux__', '-Wno-error', '-include', '@LIMBO_JNI_ROOT@/compat/limbo_compat_spice.h']
c_link_args = ['-target', '@TARGET_TRIPLE@', '--sysroot=@SYSROOT@']
cpp_link_args = ['-target', '@TARGET_TRIPLE@', '--sysroot=@SYSROOT@']
