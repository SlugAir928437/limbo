diff --git a/meson.build b/meson.build
index 10be099..a7dba4d 100644
--- a/meson.build
+++ b/meson.build
@@ -107,7 +107,17 @@ endif
 
 with_drm_renderers = drm_renderers.length() > 0
 
-libdrm_dep = dependency('libdrm', version : '>=2.4.50', required: with_drm_renderers or get_option('venus'))
+# Venus makes upstream require libdrm, but Android ships neither the library
+# (no libdrm.so / libdrm.pc anywhere in the NDK) nor its xf86drm.h header, so
+# requiring it would abort the configure step.  Nothing on the Android
+# configuration calls into libdrm: its only real users are the DRM
+# native-context renderers below (drm-renderers, off on Android) and the GBM
+# path of vrend_winsys_egl.c, which is compiled out without gbm.
+libdrm_required = with_drm_renderers
+if host_machine.system() != 'android'
+   libdrm_required = libdrm_required or get_option('venus')
+endif
+libdrm_dep = dependency('libdrm', version : '>=2.4.50', required: libdrm_required)
 libdrm_amdgpu_dep = dependency('libdrm_amdgpu', version : '>=2.4.121', required: with_drm_amdgpu)
 conf_data.set('ENABLE_DRM', libdrm_dep.found())
 
@@ -273,7 +283,13 @@ endif
 
 if with_egl
    if cc.has_header('epoxy/egl.h', dependencies: epoxy_dep) and epoxy_dep.get_variable(pkgconfig: 'epoxy_has_egl') == '1'
-      if with_host_windows or with_host_darwin
+      # Android has no gbm/libdrm, so the generic path below (have_egl =
+      # gbm_dep.found() and ...) would silently disable EGL and drop
+      # vrend_winsys_egl.c from the build.  QEMU hands us its own EGLDisplay
+      # through the get_egl_display callback (virgl_egl_init_external), which
+      # needs neither gbm nor a render node - so Android belongs in this
+      # branch, exactly like Windows and macOS.
+      if with_host_windows or with_host_darwin or host_machine.system() == 'android'
          have_egl = true
       else
          if libdrm_dep.found()
