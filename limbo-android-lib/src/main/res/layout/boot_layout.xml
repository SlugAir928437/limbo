<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bootSectionl"
    style="@style/Widget.Limbo.SectionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_normal"
    tools:showIn="@layout/limbo_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/bootheaderl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_header_padding">

            <ImageView
                android:layout_width="@dimen/section_header_icon_size"
                android:layout_height="@dimen/section_header_icon_size"
                android:layout_marginEnd="@dimen/spacing_md"
                android:src="@drawable/drives"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bootsectionStr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_boot"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="@dimen/section_header_text_size"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/bootsectionsummaryStr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text=""
                    android:textColor="@color/colorSummaryText"
                    android:textSize="@dimen/section_summary_text_size"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:background="@color/colorDivider"
            android:layout_marginHorizontal="@dimen/card_inner_padding" />

        <LinearLayout
            android:id="@+id/bootsectionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/card_inner_padding"
            android:paddingVertical="@dimen/spacing_sm">

            <LinearLayout
                android:id="@+id/bootfroml"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_item_height"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:src="@drawable/drives"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/bootfromstr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/label_boot_from_device"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />

                <Spinner
                    android:id="@+id/bootfromval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/kernell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_item_height"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:src="@drawable/sysfile"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/kernelStr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/label_kernel"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />

                <Spinner
                    android:id="@+id/kernelval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/initrdl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_item_height"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:src="@drawable/sysfile"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/initrdStr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/label_initrd"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />

                <Spinner
                    android:id="@+id/initrdval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/appendl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_item_height"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_marginEnd="@dimen/spacing_md" />

                <TextView
                    android:id="@+id/appendStr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/label_append"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />

                <EditText
                    android:id="@+id/appendval"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:background="@drawable/border"
                    android:gravity="end"
                    android:hint="ie: root=/dev/sda1"
                    android:inputType="textFilter|textNoSuggestions"
                    android:padding="8dp"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorHint"
                    android:textSize="@dimen/row_text_size" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
