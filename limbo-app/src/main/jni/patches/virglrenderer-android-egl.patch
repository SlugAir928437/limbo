 #include "server/render_protocol.h"
 
+#ifdef ENABLE_RENDER_SERVER_INPROCESS
+#include <pthread.h>
+#include <sys/socket.h>
+
+#include "server/render_server.h"
+
+static void *
+proxy_server_thread(void *opaque)
+{
+   struct proxy_server *srv = opaque;
+
+   /* takes ownership of server_fd */
+   render_server_main_fd(srv->server_fd, NULL);
+
+   return NULL;
+}
+#endif /* ENABLE_RENDER_SERVER_INPROCESS */
+
 int
 proxy_server_connect(struct proxy_server *srv)
 {
+#ifdef ENABLE_RENDER_SERVER_INPROCESS
+   /* Keep our end so proxy_server_destroy() can still shut the connection down
+    * and join the server thread. */
+   if (srv->client_fd < 0)
+      return -1;
+   return dup(srv->client_fd);
+#else
    int client_fd = srv->client_fd;
    /* transfer ownership */
    srv->client_fd = -1;
    return client_fd;
+#endif
 }
 
 void
 proxy_server_destroy(struct proxy_server *srv)
 {
+#ifdef ENABLE_RENDER_SERVER_INPROCESS
+   if (srv->thread_started) {
+      /* wake the server thread up; it closes the server end by itself */
+      if (srv->client_fd >= 0)
+         shutdown(srv->client_fd, SHUT_RDWR);
+
+      pthread_join(srv->thread, NULL);
+      srv->thread_started = false;
+   }
+#else
    if (srv->pid >= 0) {
       kill(srv->pid, SIGKILL);
 
       siginfo_t siginfo = { 0 };
       waitid(P_PID, srv->pid, &siginfo, WEXITED);
    }
+#endif
 
    if (srv->client_fd >= 0)
       close(srv->client_fd);
@@ -36,6 +73,8 @@ proxy_server_destroy(struct proxy_server *srv)
    free(srv);
 }
 
+#ifndef ENABLE_RENDER_SERVER_INPROCESS
+
 static bool
