<?xml version="1.0" encoding="utf-8"?>
<!--
    Top toolbar menu for LimboGtkActivity / LimboAglActivity. Mirrors the SDL
    runtime menu (sdlactivitymenu.xml) minus the entries that only make sense
    for the SDL display backend (mouse modes, key mapper, ...).
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/itemKeyboard"
        android:icon="@drawable/keyboard"
        android:title="@string/showkbd_label" />

    <item
        android:id="@+id/itemDrives"
        android:icon="@drawable/drives"
        android:title="@string/drives" />

    <item
        android:id="@+id/itemVolume"
        android:icon="@drawable/audiocard"
        android:title="@string/volume" />

    <item
        android:id="@+id/itemSaveState"
        android:icon="@drawable/pause"
        android:title="@string/save_state" />

    <item
        android:id="@+id/itemReset"
        android:icon="@drawable/reset"
        android:title="@string/reset" />

    <item
        android:id="@+id/itemShutdown"
        android:icon="@drawable/shutdown"
        android:title="@string/shutdown" />

    <item
        android:id="@+id/itemDisconnet"
        android:icon="@drawable/disconnect"
        android:title="@string/disconnect" />

    <item
        android:id="@+id/itemViewLog"
        android:icon="@android:drawable/ic_menu_info_details"
        android:title="@string/view_log" />

    <item
        android:id="@+id/itemHelp"
        android:icon="@drawable/help"
        android:title="@string/help" />

    <!-- 可变刷新率（VRR），由 LimboGtkActivity / LimboAglActivity 处理：
         -1=跟随屏幕 0=关闭 >0=目标频率(Hz) -->
    <item
        android:id="@+id/itemRefreshRate"
        android:icon="@android:drawable/ic_menu_recent_history"
        android:title="@string/refresh_rate">
        <menu>
            <group
                android:id="@+id/groupRefreshRate"
                android:checkableBehavior="single">
                <item
                    android:id="@+id/itemRefreshOff"
                    android:title="@string/refresh_rate_off" />
                <item
                    android:id="@+id/itemRefreshAuto"
                    android:title="@string/refresh_rate_auto" />
                <item
                    android:id="@+id/itemRefresh60"
                    android:title="@string/refresh_rate_60" />
                <item
                    android:id="@+id/itemRefresh90"
                    android:title="@string/refresh_rate_90" />
                <item
                    android:id="@+id/itemRefresh120"
                    android:title="@string/refresh_rate_120" />
            </group>
        </menu>
    </item>

</menu>
