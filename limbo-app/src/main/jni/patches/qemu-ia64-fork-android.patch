diff --git a/meson.build b/meson.build
index f49dccc..bb01e1c 100644
--- a/meson.build
+++ b/meson.build
@@ -2035,6 +2035,19 @@ if android_host
   x11 = not_found
 endif
 
+# On Android, spice-server (>=0.15, now implemented in C++) is only available
+# as a static archive (libspice-server.a). Its C++ ABI/runtime symbols
+# (__cxxabiv1::* typeinfo vtables, __cxa_pure_virtual, operator new, ...) are
+# therefore not resolved by a plain -lspice-server, and the meson project does
+# not declare a C++ compiler, so ld.lld fails with undefined __cxxabiv1::* /
+# __cxa_pure_virtual symbols. Link the NDK libc++ runtime explicitly; the libs
+# are carried as link_args on the spice dependency so -lc++_static/-lc++abi
+# are ordered after -lspice-server on the link line.
+if android_host and spice.found()
+  spice = declare_dependency(dependencies: spice,
+                             link_args: ['-lc++_static', '-lc++abi'])
+endif
+
 png = not_found
 if get_option('png').allowed() and have_system
    png = dependency('libpng', version: '>=1.6.34', required: get_option('png'),
@@ -2733,7 +2746,13 @@ config_host_data.set('CONFIG_ARPA_INET_64', cc.has_function('htonll'))
 # syscall-based fallback, otherwise it would call an undeclared function.
 have_copy_file_range = cc.has_function('copy_file_range')
 if cc.get_define('__ANDROID__') != ''
-  have_copy_file_range = false
+  # limbo: bionic does not declare copy_file_range() below API 30, but we link
+  # a real implementation from limbo_compat_stubs.c (implemented directly on
+  # __NR_copy_file_range). Force this ON so block/file-posix.c takes the syscall
+  # path and does NOT compile its own `static ssize_t copy_file_range(...)`
+  # fallback, which would clash with the non-static prototype that
+  # limbo_compat.h declares under the same API guard.
+  have_copy_file_range = true
 endif
 config_host_data.set('HAVE_COPY_FILE_RANGE', have_copy_file_range)
 config_host_data.set('HAVE_GETIFADDRS', cc.has_function('getifaddrs'))
diff --git a/tests/meson.build b/tests/meson.build
index 9ba04bb..69614dc 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -1,3 +1,13 @@
+# The Android / Limbo build is a production emulator cross build: the QEMU
+# host test binaries (bench/fp/unit/qtest/...) are neither shipped nor runnable
+# on device, and many fail to compile under the Android cross toolchain (e.g.
+# the berkeley softfloat/testfloat FENV pragmas under -Ofast). Skip all of
+# tests/ on the Android host, mirroring the android_host compiler probe used in
+# the top-level meson.build.
+if get_variable('android_host', false)
+  subdir_done()
+endif
+
 subdir('bench')
 subdir('qemu-iotests')
 
