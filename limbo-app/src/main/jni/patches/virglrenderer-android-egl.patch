 {
@@ -78,12 +117,50 @@ proxy_server_fork(struct proxy_server *srv)
 
       proxy_log("failed to exec %s: %s", argv[0], strerror(errno));
       close(remote_fd);
-      exit(-1);
+      /* _exit() and not exit(): the child inherited the host's atexit handlers
+       * (SDL, EGL, ...) which must not run here. */
+      _exit(-1);
+   }
+
+   return true;
+}
+
+#else /* ENABLE_RENDER_SERVER_INPROCESS */
+
+static bool
+proxy_server_create_thread(struct proxy_server *srv)
+{
+   int socket_fds[2];
+   if (!proxy_socket_pair(socket_fds))
+      return false;
+   const int client_fd = socket_fds[0];
+   const int server_fd = socket_fds[1];
+
+   if (!proxy_socket_is_seqpacket(client_fd)) {
+      proxy_log("invalid client fd type");
+      close(client_fd);
+      close(server_fd);
+      return false;
+   }
+
+   srv->client_fd = client_fd;
+   srv->server_fd = server_fd;
+
+   if (pthread_create(&srv->thread, NULL, proxy_server_thread, srv)) {
+      proxy_log("failed to create render server thread");
+      srv->client_fd = -1;
+      srv->server_fd = -1;
+      close(client_fd);
+      close(server_fd);
+      return false;
    }
+   srv->thread_started = true;
 
    return true;
 }
 
+#endif /* ENABLE_RENDER_SERVER_INPROCESS */
+
 static bool
 proxy_server_init_fd(struct proxy_server *srv)
 {
@@ -102,13 +179,21 @@ proxy_server_create(void)
