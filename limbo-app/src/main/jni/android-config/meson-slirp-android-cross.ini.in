[binaries]
c = '@CC@'
ar = '@AR@'
strip = '@STRIP@'
pkgconfig = '@PKG_CONFIG@'
pkg-config = '@PKG_CONFIG@'

[host_machine]
system = 'android'
cpu_family = '@MESON_CPU_FAMILY@'
cpu = '@MESON_CPU@'
endian = 'little'

[properties]
needs_exe_wrapper = true

[built-in options]
prefix = '@SLIRP_INSTALL_DIR@'
libdir = 'lib'
buildtype = 'release'
default_library = 'static'
c_args = ['-target', '@TARGET_TRIPLE@', '--sysroot=@SYSROOT@', '-D__LIMBO__', '-D__ANDROID__', '-DANDROID', '-I@LIMBO_JNI_ROOT@/compat', '-I@LIMBO_JNI_ROOT@/compat/musl', '-I@LIMBO_JNI_ROOT@/compat/musl/include']
c_link_args = ['-target', '@TARGET_TRIPLE@', '--sysroot=@SYSROOT@', '-L@NDK_PROJECT_PATH@/obj/local/@APP_ABI@', '-lcompat-musl', '-llog', '-lunwind', '-Wl,-z,max-page-size=16384', '-Wl,-z,common-page-size=16384']