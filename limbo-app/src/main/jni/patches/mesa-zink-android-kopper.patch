+static void
+droid_kopper_set_surface_create_info(void *draw, struct kopper_loader_info *ci)
+{
+   struct dri2_egl_surface *dri2_surf = draw;
+   VkAndroidSurfaceCreateInfoKHR *android = (VkAndroidSurfaceCreateInfoKHR *)&ci->bos;
+
+   if (dri2_surf->base.Type != EGL_WINDOW_BIT)
+      return;
+   android->sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+   android->pNext = NULL;
+   android->flags = 0;
+   android->window = dri2_surf->window;
+   ci->has_alpha = dri2_surf->base.Config->AlphaSize > 0;
+   ci->present_opaque = dri2_surf->base.PresentOpaque;
+}
+
+static void
+droid_kopper_get_drawable_info(struct dri_drawable *draw, int *w, int *h,
+                               void *loaderPrivate)
+{
+   struct dri2_egl_surface *dri2_surf = loaderPrivate;
+   int width = 0, height = 0;
+
+   if (dri2_surf->window) {
+      ANativeWindow_query(dri2_surf->window,
+                          ANATIVEWINDOW_QUERY_DEFAULT_WIDTH, &width);
+      ANativeWindow_query(dri2_surf->window,
+                          ANATIVEWINDOW_QUERY_DEFAULT_HEIGHT, &height);
+   }
+   /* 刚建好时 Surface 可能还没有 geometry，退回 EGL 配置里的尺寸。 */
+   if (width <= 0)
+      width = dri2_surf->base.Width > 0 ? dri2_surf->base.Width : 1;
+   if (height <= 0)
+      height = dri2_surf->base.Height > 0 ? dri2_surf->base.Height : 1;
+   *w = width;
+   *h = height;
+}
