+ * Whether VIRTIO_RING_F_EVENT_IDX may be offered to guests.  False by default
+ * under gzvm; see the comment on the definition in accel/gzvm/gzvm-accel-ops.c.
+ */
+bool gzvm_event_idx_allowed(void);
