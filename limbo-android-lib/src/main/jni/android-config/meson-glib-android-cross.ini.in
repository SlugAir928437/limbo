[binaries]
c = '@CC@'
cpp = '@CXX@'
ar = '@AR@'
strip = '@STRIP@'
pkgconfig = '@PKG_CONFIG@'

[host_machine]
system = 'android'
cpu_family = '@MESON_CPU_FAMILY@'
cpu = '@MESON_CPU@'
endian = 'little'

[properties]
needs_exe_wrapper = true
have_c99_vsnprintf = true
have_c99_snprintf = true
have_unix98_printf = true
va_val_copy = true
growing_stack = false

[built-in options]
prefix = '@GLIB_INSTALL_DIR@'
libdir = 'lib'
buildtype = '@LIBGLIB_BUILDTYPE@'
default_library = 'shared'
c_args = [
  '-target', '@TARGET_TRIPLE@',
  '--sysroot=@SYSROOT@',
  '-D__ANDROID_API__=@ANDROID_API@',
  '-D__LIMBO__',
  '-D__ANDROID__',
  '-DANDROID',
  '-I@LIMBO_JNI_ROOT@/compat',
  '-I@LIMBO_JNI_ROOT@/compat/musl',
  '-I@LIMBO_JNI_ROOT@/compat/musl/include'
]
cpp_args = [
  '-target', '@TARGET_TRIPLE@',
  '--sysroot=@SYSROOT@',
  '-D__ANDROID_API__=@ANDROID_API@',
  '-D__LIMBO__',
  '-D__ANDROID__',
  '-DANDROID',
  '-I@LIMBO_JNI_ROOT@/compat',
  '-I@LIMBO_JNI_ROOT@/compat/musl',
  '-I@LIMBO_JNI_ROOT@/compat/musl/include'
]
c_link_args = [
  '-target', '@TARGET_TRIPLE@',
  '--sysroot=@SYSROOT@',
  '-L@NDK_PROJECT_PATH@/obj/local/@APP_ABI@',
  '-lcompat-musl',
  '-llog',
  '-lunwind'
]
cpp_link_args = [
  '-target', '@TARGET_TRIPLE@',
  '--sysroot=@SYSROOT@',
  '-L@NDK_PROJECT_PATH@/obj/local/@APP_ABI@',
  '-lcompat-musl',
  '-llog',
  '-lunwind'
]

[project options]
internal_pcre = true
iconv = 'external'
force_posix_threads = true
libmount = 'disabled'
selinux = 'disabled'
xattr = false
dtrace = false
systemtap = false
man = false
gtk_doc = false
installed_tests = false
nls = 'disabled'
bsymbolic_functions = false
glib_assert = false
glib_checks = false
