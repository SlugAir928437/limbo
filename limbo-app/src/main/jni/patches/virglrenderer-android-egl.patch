+static int
+vkr_ahb_bo_get_fd(void *ahb_bo)
+{
+   struct vkr_ahb_bo *bo = ahb_bo;
+   const struct vkr_native_handle *handle;
+
+   if (!bo || !bo->get_native_handle)
+      return -1;
+
+   handle = bo->get_native_handle(bo->buffer);
+   if (!handle) {
+      vkr_log("AHardwareBuffer has no native handle");
+      return -1;
+   }
