--- a/server/render_server.c
+++ b/server/render_server.c
@@ -13,6 +13,14 @@
 #include "render_client.h"
 #include "render_worker.h"
 
+#ifdef ENABLE_RENDER_SERVER_INPROCESS
+/* An in-process server must run its contexts as threads: a forked worker would
+ * not be able to talk back to the client through the shared address space. */
+#if !defined(ENABLE_RENDER_SERVER_WORKER_THREAD)
+#error "in-process render server requires render-server-worker=thread"
+#endif
+#endif
+
 #define RENDER_SERVER_MAX_WORKER_COUNT 256
 
 enum render_server_poll_type {
@@ -218,3 +226,51 @@ render_server_main(int argc, char **argv, struct render_context_args *ctx_args)
 
    return ok;
 }
+
+#ifdef ENABLE_RENDER_SERVER_INPROCESS
+
+/* Same setup as render_server_main(), but takes an already connected fd and
+ * skips option parsing (getopt state is process-global and already used by the
+ * host).  Used to host the server on a thread inside the client process.
+ *
+ * Owns client_fd from the moment it is called, even on failure. */
+bool
+render_server_main_fd(int client_fd, struct render_context_args *ctx_args)
+{
+   struct render_server srv;
+
+   memset(&srv, 0, sizeof(srv));
+   srv.state = RENDER_SERVER_STATE_RUN;
+   srv.context_args = ctx_args;
+   srv.client_fd = client_fd;
+
+   if (srv.client_fd < 0 || !render_socket_is_seqpacket(srv.client_fd)) {
+      render_log("no valid client fd specified");
+      render_server_fini(&srv);
+      return false;
+   }
+
+   srv.worker_jail = render_worker_jail_create(RENDER_SERVER_MAX_WORKER_COUNT,
+                                               RENDER_WORKER_JAIL_SECCOMP_NONE, NULL);
+   if (!srv.worker_jail) {
+      render_log("failed to create worker jail");
+      render_server_fini(&srv);
+      return false;
+   }
+
+   srv.client = render_client_create(&srv, srv.client_fd);
+   if (!srv.client) {
+      render_log("failed to create client");
+      render_server_fini(&srv);
+      return false;
+   }
+   /* ownership transferred */
+   srv.client_fd = -1;
+
+   const bool ok = render_server_run(&srv);
+   render_server_fini(&srv);
+
+   return ok;
+}
+
+#endif /* ENABLE_RENDER_SERVER_INPROCESS */
