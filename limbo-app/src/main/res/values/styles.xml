<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base application theme -->
    <!-- 应用级主题（AndroidManifest 的 <application android:theme>）。
         没有它时 Application Context 的主题是平台默认主题，不是 Theme.AppCompat 的后代，
         任何用 Application Context 构造的 Material 组件（如 MaterialAlertDialogBuilder）
         都会抛出 IllegalArgumentException: The style on this component requires your app
         theme to be Theme.AppCompat (or a descendant)。
         各 Activity 在清单里另有自己的主题，不受影响。
         配色统一改为 Miuix（小米 HyperOS）色板，与 Compose 端的 MiuixTheme 保持一致。 -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/miuix_window_background</item>
        <item name="colorPrimary">@color/miuix_primary</item>
        <item name="colorPrimaryVariant">@color/miuix_primary_variant</item>
        <item name="colorOnPrimary">@color/miuix_on_primary</item>
        <item name="colorSecondary">@color/miuix_secondary</item>
        <item name="colorOnSecondary">@color/miuix_on_secondary</item>
        <item name="android:colorAccent">@color/miuix_primary</item>
    </style>

    <!-- NoActionBar variant for emulator activities (Miuix / HyperOS colors, matched with the Compose theme) -->
    <style name="AppTheme.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/miuix_window_background</item>
        <item name="colorPrimary">@color/miuix_primary</item>
        <item name="colorPrimaryVariant">@color/miuix_primary_variant</item>
        <item name="colorOnPrimary">@color/miuix_on_primary</item>
        <item name="colorSecondary">@color/miuix_secondary</item>
        <item name="colorOnSecondary">@color/miuix_on_secondary</item>
        <item name="android:colorAccent">@color/miuix_primary</item>
    </style>

    <!-- Shape Appearances -->
    <style name="Transparent" parent="@android:style/Theme.Dialog"></style>

    <style name="leftEllipsisSpinnerDropDownItem" parent="@android:style/Widget.DropDownItem.Spinner">
        <item name="android:ellipsize">start</item>
        <item name="android:singleLine">true</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="leftEllipsisSimpleSpinnerItem" parent="@android:style/Widget.TextView.SpinnerItem">
        <item name="android:ellipsize">start</item>
        <item name="android:singleLine">true</item>
        <item name="android:padding">8dp</item>
    </style>

    <!-- Netcat session as a Material 3 dialog (matched with the app's M3 theme).
     Using a MaterialComponents (M2) dialog theme inside a Material3 activity
     left the dialog content blank; keep the dialog on Material3. -->
    <style name="Theme.NetcatSession.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/miuix_primary</item>
        <item name="colorPrimaryVariant">@color/miuix_primary_variant</item>
        <item name="colorSecondary">@color/miuix_primary</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
