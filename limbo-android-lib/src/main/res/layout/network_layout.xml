<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/networksectionl"
    style="@style/Widget.Limbo.SectionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_normal"
    tools:showIn="@layout/limbo_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/networkheaderl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_header_padding">

            <ImageView
                android:layout_width="@dimen/section_header_icon_size"
                android:layout_height="@dimen/section_header_icon_size"
                android:layout_marginEnd="@dimen/spacing_md"
                android:src="@drawable/network"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/networksectionStr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_network"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="@dimen/section_header_text_size"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/networksectionsummaryStr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text=""
                    android:textColor="@color/colorSummaryText"
                    android:textSize="@dimen/section_summary_text_size"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:background="@color/colorDivider"
            android:layout_marginHorizontal="@dimen/card_inner_padding" />

        <LinearLayout
            android:id="@+id/networksectionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/card_inner_padding"
            android:paddingVertical="@dimen/spacing_sm">

            <LinearLayout
                android:id="@+id/netcfgl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_item_height"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:src="@drawable/network"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/netcfgStr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/label_network"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />

                <Spinner
                    android:id="@+id/netcfgval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/netDeviceslm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_item_height"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:src="@drawable/networkcard"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/netDevicesStr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/label_network_card"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />

                <Spinner
                    android:id="@+id/netDevicesVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dnsl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_item_height"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:src="@drawable/dnsserver"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/dnsStr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/label_dns_server"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />

                <EditText
                    android:id="@+id/dnsval"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:background="@drawable/border"
                    android:digits="0123456789."
                    android:enabled="false"
                    android:gravity="end"
                    android:inputType="textFilter|textNoSuggestions"
                    android:padding="8dp"
                    android:singleLine="true"
                    android:text="8.8.8.8"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hostfwdl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_item_height"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/row_icon_size"
                    android:layout_height="@dimen/row_icon_size"
                    android:layout_marginEnd="@dimen/spacing_md" />

                <TextView
                    android:id="@+id/hostfwdStr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/label_host_forward"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="@dimen/row_text_size" />

                <EditText
                    android:id="@+id/hostfwdval"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:background="@drawable/border"
                    android:enabled="false"
                    android:gravity="end"
                    android:hint="tcp:hostport1:guestport1,udp:hostport2:questport2,..."
                    android:inputType="textFilter|textNoSuggestions"
                    android:padding="8dp"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorHint"
                    android:textSize="@dimen/row_text_size" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
