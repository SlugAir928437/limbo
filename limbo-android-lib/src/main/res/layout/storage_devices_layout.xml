<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/storagedevicesectionl"
    style="@style/Widget.Limbo.SectionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_normal"
    tools:showIn="@layout/limbo_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Section Header -->
        <LinearLayout
            android:id="@+id/storagedevicesheaderl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_header_padding">

            <ImageView
                android:layout_width="@dimen/section_header_icon_size"
                android:layout_height="@dimen/section_header_icon_size"
                android:layout_marginEnd="@dimen/spacing_md"
                android:src="@drawable/harddisk"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/storagedevicessectionStr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_storage_devices"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="@dimen/section_header_text_size"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/storagedevicessummaryStr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text=""
                    android:textColor="@color/colorSummaryText"
                    android:textSize="@dimen/section_summary_text_size"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:background="@color/colorDivider"
            android:layout_marginHorizontal="@dimen/card_inner_padding" />

        <!-- Section Details -->
        <LinearLayout
            android:id="@+id/storagedevicessectionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/card_inner_padding"
            android:paddingVertical="@dimen/spacing_sm">

            <!-- Dynamic device rows container -->
            <LinearLayout
                android:id="@+id/storageDevicesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Add device button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/addStorageDeviceBtn"
                style="@style/Widget.Limbo.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/add_storage_device" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
