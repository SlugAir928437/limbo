+      /* dma-buf fds report their size through lseek; the allocation may be
+       * rounded up by gralloc, so only reject fds that are too small. */
+      const int fd = handle->data[i];
+      const off_t size = lseek(fd, 0, SEEK_END);
+      if (size < 0 || (uint64_t)size < bo->size)
+         continue;
