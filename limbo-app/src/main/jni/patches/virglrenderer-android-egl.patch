+   srv->server_fd = -1;
+#else
    srv->pid = -1;
+#endif
 
    if (!proxy_server_init_fd(srv)) {
       /* start the render server on demand when the client does not provide a
        * server fd
        */
+#ifdef ENABLE_RENDER_SERVER_INPROCESS
+      if (!proxy_server_create_thread(srv)) {
+#else
       if (!proxy_server_fork(srv)) {
+#endif
          free(srv);
          return NULL;
       }
@@ -121,7 +206,11 @@ proxy_server_create(void)
       return NULL;
    }
 
+#ifdef ENABLE_RENDER_SERVER_INPROCESS
+   proxy_log("proxy server running in-process");
+#else
    proxy_log("proxy server with pid %d", srv->pid);
+#endif
 
    return srv;
 }
